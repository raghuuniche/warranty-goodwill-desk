# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...

# The course notebook uses gpt-5.5. Change if you are pointing elsewhere.
MODEL=gpt-5.5

# Price per 1M tokens, used only for the cost display.
PRICE_IN=1.25
PRICE_OUT=10.00

# LangSmith tracing. Optional but do turn it on, it is half the learning.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=goodwill-desk
